# Maintainer: nava <nava@noreply.com>
#
# Matrix Player — Arch packages, four microarchitecture variants.
#
# ONE makepkg run produces FOUR packages. Each is SELF-CONTAINED: a person
# downloads exactly one file, runs `pacman -U`, and it works. That requirement
# is why the 124 MB of fonts is duplicated into every variant instead of being
# split into a shared -data package — a dependency on a second package would
# make `pacman -U` fail for anyone who downloaded only the one.
#
#   makepkg              # all four, ~30 min (each -march forces a full rebuild)
#   makepkg --pkg matrix-player-v3    # just one
#
# Builds the latest pushed main. Commit and push first (./git_wrapper save,
# which pushes SUBMODULES before the parent) — a parent commit pointing at
# unpushed submodule commits fails in prepare().
#
# Which variant is which:
#   universal  portable generic x86-64 — works on ANY x86-64 CPU
#   v3         AVX2/BMI2      (Intel Haswell 2013+, AMD Excavator/Zen 2015+)
#   v4         AVX-512        (Intel Skylake-X/Ice Lake+, AMD Zen 4+)
#   zen4       -march=znver4  (AMD Zen 4 specifically)
#
# A downloader finds their level with:
#   /lib/ld-linux-x86-64.so.2 --help | grep -A4 'Subdirectories of glibc-hwcaps'
#
# NOTE: -march=native is deliberately NOT offered. It bakes in whatever the
# BUILD machine supports and SIGILLs on anything older — fine for a local
# install, never for something uploaded.

pkgbase=matrix-player
pkgname=('matrix-player-universal'
         'matrix-player-v3'
         'matrix-player-v4'
         'matrix-player-zen4')
pkgver=0.1.0.r66.g74dcb76
pkgrel=1
arch=('x86_64')
url='https://github.com/minervarr/Matrix_Player'
license=('custom')

# Only these six are dynamic. Everything else — libFLAC, libmpg123, libusb,
# soxr, libjpeg-turbo, freetype, msdfgen, sqlite3 — is linked statically into
# the binary, by design. pacman enforces these on `pacman -U`, so they are what
# stands between a downloader and a missing-library error at first launch.
depends=('alsa-lib' 'jack2' 'vulkan-icd-loader' 'wayland' 'libxkbcommon' 'gcc-libs')

# shader-slang-bin: slangc is REQUIRED at build time — no .spv is committed,
#   and VceShaders.cmake otherwise falls back to a hardcoded Windows path.
# nasm: libjpeg-turbo's SIMD. Without it JPEG artwork decode silently drops to
#   the C paths.
# wayland-protocols + wayland: wayland-scanner generates the xdg-shell and
#   idle-inhibit glue from the system protocol XML at build time.
makedepends=('git' 'cmake' 'ninja' 'shader-slang-bin' 'vulkan-headers'
             'wayland-protocols' 'nasm')

options=('!lto' '!debug')

# libmpg123 is NOT in git — audio_engine's initialize_files.py normally
# downloads it, which cannot happen inside build(). Fetched here instead so
# makepkg checksums it. Pin matches initialize_files.py's COMPONENTS table.
_mpg123ver=1.32.10

source=("matrix_player::git+https://github.com/minervarr/Matrix_Player.git#branch=main"
        "https://www.mpg123.de/download/mpg123-${_mpg123ver}.tar.bz2"
        'matrix-player.desktop'
        'matrix-player.svg')
sha256sums=('SKIP'
            '87b2c17fe0c979d3ef38eeceff6362b35b28ac8589fbf1854b5be75c9ab6557c'
            'SKIP'
            'SKIP')

PKGEXT='.pkg.tar.zst'
# The 124 MB of bundled fonts dominate everything here, and they are already
# compressed formats. zstd -1 keeps four packaging passes to seconds rather
# than minutes, at a few MB of size.
COMPRESSZST=(zstd -c -T0 -1 -)

# variant -> MATRIX_ARCH_LEVEL ("" = the compiler's portable baseline).
# Same set scripts/linux/build.sh --share produces as tarballs, so the two
# distribution paths stay in step.
_arch_level() {
    case "$1" in
        universal) printf '' ;;
        v3)        printf 'v3' ;;
        v4)        printf 'v4' ;;
        zen4)      printf 'znver4' ;;
        *)         echo "unknown variant: $1" >&2; return 1 ;;
    esac
}

_slangc() { command -v slangc || echo /opt/shader-slang-bin/bin/slangc; }

pkgver() {
    cd "${srcdir}/matrix_player"
    # No git tags exist; 0.1.0 is manifest.json's version field.
    printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "${srcdir}/matrix_player"

    # 10 submodules, 3 levels deep. Writing the full `git config submodule.*.url`
    # dance for a nested tree this size is not worth it for a release build run
    # by hand; it does mean prepare() touches the network, a deliberate
    # deviation from Arch policy. Running once for all four variants is the main
    # reason this is a split package rather than four separate makepkg runs.
    git submodule update --init --recursive

    # ae_mpg123.cmake reads third_party/mpg123/src/{libmpg123,compat,common,
    # include} and src/version.h. The release tarball has exactly that layout
    # under its top-level directory, so a symlink is enough — initialize_files.py
    # only filters that same tree down to a subset.
    #
    # Guarded loudly: if this path is ever wrong, core/CMakeLists.txt merely
    # WARNS about the missing ae_mp3 target, and every uploaded package would
    # silently play everything except MP3.
    local _mpg="${srcdir}/mpg123-${_mpg123ver}"
    [[ -f "${_mpg}/src/libmpg123/libmpg123.c" ]] || {
        echo "==> ERROR: mpg123 source not where ae_mpg123.cmake expects it" >&2
        return 1
    }
    ln -sfn "${_mpg}" framework/audio_engine/third_party/mpg123
}

build() {
    local _v _level _arch_arg
    for _v in universal v3 v4 zen4; do
        _level="$(_arch_level "$_v")"
        _arch_arg=()
        [[ -n "$_level" ]] && _arch_arg=(-DMATRIX_ARCH_LEVEL="$_level")

        echo "==> Building variant '${_v}'${_level:+ (-march=${_level})}"

        # MATRIX_STATE_HOME is what makes the read-only /opt install work:
        # the DB, log and ~45 MB atlas cache go to $HOME/.matrix_player
        # instead of next to the binary. See gui/src/app_paths.hh.
        #
        # -ffp-contract=off is NOT passed here — the root CMakeLists applies it
        # to every build. It is load-bearing for exactly these variants: at v3
        # and above FMA exists, and GCC's default contraction fuses the EQ's
        # biquad accumulator into results that no longer match the frozen
        # oracle. check() below re-verifies that per variant.
        cmake -S matrix_player -B "build-${_v}" -G Ninja \
            -DCMAKE_BUILD_TYPE=Release \
            -DMATRIX_STATE_HOME=.matrix_player \
            -DVCE_SLANGC="$(_slangc)" \
            -DAUDIO_ENGINE_BUILD_TOOLS=OFF \
            -DMATRIX_BUILD_AB_TEST=OFF \
            "${_arch_arg[@]}"
        cmake --build "build-${_v}"
    done
}

check() {
    # The audio path's bit-exactness gate, per variant.
    #
    # dsp_null_test is Debug-gated, so each variant gets a second, minimal tree
    # — but only the one target is built, and it links almost nothing (ae_core
    # is an INTERFACE target), so this costs a configure plus two compile steps
    # rather than another full build.
    #
    # A variant the BUILD machine cannot execute dies with SIGILL. That is
    # reported as SKIPPED, never folded into "passed" — an untested variant
    # must not look like a verified one.
    #
    # Measured on an i7-11800H (Tiger Lake-H): all four variants RUN and pass,
    # zen4 included — it and Tiger Lake share AVX-512, and GCC emits nothing
    # Zen-only for this code. The guard is here for the machines where that
    # stops being true: build v4 or zen4 on a pre-AVX-512 CPU and those two
    # cannot be executed locally, only built.
    local _v _level _arch_arg _rc _skipped=()
    for _v in universal v3 v4 zen4; do
        _level="$(_arch_level "$_v")"
        _arch_arg=()
        [[ -n "$_level" ]] && _arch_arg=(-DMATRIX_ARCH_LEVEL="$_level")

        cmake -S matrix_player -B "check-${_v}" -G Ninja \
            -DCMAKE_BUILD_TYPE=Debug \
            -DVCE_SLANGC="$(_slangc)" \
            -DAUDIO_ENGINE_BUILD_TOOLS=OFF \
            "${_arch_arg[@]}" > /dev/null
        cmake --build "check-${_v}" --target dsp_null_test > /dev/null

        echo "==> dsp_null_test [${_v}]"
        _rc=0
        "./check-${_v}/framework/audio_engine/dsp_null_test" || _rc=$?
        if (( _rc == 132 )); then          # 128 + SIGILL
            echo "    SKIPPED — this CPU cannot execute ${_level:-baseline} code"
            _skipped+=("$_v")
        elif (( _rc != 0 )); then
            echo "    FAILED (exit ${_rc}) — the audio path changed for '${_v}'" >&2
            return 1
        fi
    done
    (( ${#_skipped[@]} )) && \
        echo "==> NOTE: unverified on this machine: ${_skipped[*]} — test on target hardware"
    return 0
}

# Everything a variant installs. Identical for all four apart from which
# build-<variant>/ the binary comes from.
_package_variant() {
    local _v="$1"
    cd "${srcdir}"

    install -dm755 "${pkgdir}/opt/matrix_player"
    install -Dm755 "build-${_v}/gui/matrix_player" \
        "${pkgdir}/opt/matrix_player/matrix_player"
    install -Dm644 matrix_player/eq_profiles.json \
        "${pkgdir}/opt/matrix_player/eq_profiles.json"

    # Shaders from the BUILD tree (compiled .spv), fonts from the SOURCE tree.
    # Deliberately not from build-*/gui/, where the POST_BUILD steps put copies
    # of both: a stale ~45 MB *.msdf.cache left there by a previous run would be
    # packaged along with them.
    cp -r "build-${_v}/assets"        "${pkgdir}/opt/matrix_player/assets"
    cp -r matrix_player/assets/fonts  "${pkgdir}/opt/matrix_player/fonts"
    find "${pkgdir}/opt/matrix_player/assets" "${pkgdir}/opt/matrix_player/fonts" \
        -type f -exec chmod 644 {} +

    # A symlink, not a wrapper: readlink("/proc/self/exe") resolves it, so
    # app_paths::exeDir() still reports /opt/matrix_player/.
    install -dm755 "${pkgdir}/usr/bin"
    ln -s /opt/matrix_player/matrix_player "${pkgdir}/usr/bin/matrix_player"

    # uaccess for the DAC. The 70- prefix must sort below 73-seat-late.rules —
    # see the header comment in the rule itself.
    install -Dm644 matrix_player/scripts/linux/70-matrix-player-usb.rules \
        "${pkgdir}/usr/lib/udev/rules.d/70-matrix-player-usb.rules"

    install -Dm644 matrix-player.desktop \
        "${pkgdir}/usr/share/applications/matrix-player.desktop"
    install -Dm644 matrix-player.svg \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/matrix-player.svg"

    # Static linking pulls these libraries' notices into the binary, so they
    # ship with it. Paths tolerate a submodule reorganising its license file.
    local _lic="${pkgdir}/usr/share/licenses/matrix-player-${_v}" f _src _name
    install -dm755 "${_lic}"
    install -Dm644 matrix_player/LICENSE "${_lic}/LICENSE"
    for f in \
        "framework/audio_engine/LICENSE:audio_engine" \
        "framework/vk_canvas/LICENSE:vk_canvas" \
        "framework/audio_engine/third_party/flac/COPYING.Xiph:libFLAC" \
        "framework/audio_engine/third_party/libusb/COPYING:libusb" \
        "framework/vk_canvas/first_party/vulkan_font_engine/third_party/freetype/LICENSE.TXT:freetype" \
        "framework/vk_canvas/first_party/vulkan_font_engine/third_party/msdfgen/LICENSE.txt:msdfgen" \
        "third_party/soxr/COPYING.LGPL:soxr" \
        "third_party/libjpeg-turbo/LICENSE.md:libjpeg-turbo"
    do
        _src="matrix_player/${f%%:*}"; _name="${f##*:}"
        [[ -f "${_src}" ]] && install -Dm644 "${_src}" "${_lic}/LICENSE.${_name}"
    done
    # mpg123 comes from the tarball, not the git tree.
    install -Dm644 "mpg123-${_mpg123ver}/COPYING" "${_lic}/LICENSE.libmpg123"
}

# All four provide and conflict with 'matrix-player', so pacman refuses to hold
# two variants at once and swapping one for another is a single -U.

package_matrix-player-universal() {
    pkgdesc="Native C++17 music player driving a USB DAC directly (portable x86-64 build)"
    provides=('matrix-player'); conflicts=('matrix-player')
    install=matrix-player.install
    _package_variant universal
}

package_matrix-player-v3() {
    pkgdesc="Native C++17 music player driving a USB DAC directly (x86-64-v3 / AVX2)"
    provides=('matrix-player'); conflicts=('matrix-player')
    install=matrix-player.install
    _package_variant v3
}

package_matrix-player-v4() {
    pkgdesc="Native C++17 music player driving a USB DAC directly (x86-64-v4 / AVX-512)"
    provides=('matrix-player'); conflicts=('matrix-player')
    install=matrix-player.install
    _package_variant v4
}

package_matrix-player-zen4() {
    pkgdesc="Native C++17 music player driving a USB DAC directly (AMD Zen 4 tuned)"
    provides=('matrix-player'); conflicts=('matrix-player')
    install=matrix-player.install
    _package_variant zen4
}
