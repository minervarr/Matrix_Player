# soxr pinned at 945b592 (https://github.com/chirlu/soxr). Not our repo.
# CMake 3.22 policy warnings, C99 bool, and Clang fixes kept on our side.
# From Matrix_Player: git -C third_party/soxr apply ../../patches/soxr-modern-cmake.patch

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ee48f6c..44d9dca 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2,6 +2,18 @@
 # Licence for this file: LGPL v2.1                  See LICENCE for details.
 
 cmake_minimum_required (VERSION 3.1 FATAL_ERROR)
+# cmake_dependent_option below uses the original semicolon conditions.
+# Unset CMP0127 warns on every configure from CMake 3.22 onward.
+if (POLICY CMP0127)
+  cmake_policy (SET CMP0127 OLD)
+endif ()
+# check_include_files runs while CMAKE_REQUIRED_LIBRARIES is set for lrint.
+# Unset CMP0075 warns on CMake 3.12+. NEW links that list into the probe.
+# libm is present wherever lrint needs it, and these are header probes, so
+# the result does not change. OLD is itself deprecated.
+if (POLICY CMP0075)
+  cmake_policy (SET CMP0075 NEW)
+endif ()
 
 project (soxr C)
 set (DESCRIPTION_SUMMARY
@@ -161,9 +173,9 @@ if (CMAKE_C_COMPILER_ID STREQUAL "GNU" OR CMAKE_C_COMPILER_ID STREQUAL "Clang")
   if (WITH_DEV_GPROF)
     set (PROJECT_CXX_FLAGS "${PROJECT_CXX_FLAGS} -pg")
   endif ()
-  # Can use std=c89, but gnu89 should give faster sinf, cosf, etc.:
+  # bool/_Bool is C99. gnu89 plus -pedantic warns on every use of it.
   set (PROJECT_C_FLAGS "${PROJECT_CXX_FLAGS} \
-       -std=gnu89 -Wnested-externs -Wmissing-prototypes -Wstrict-prototypes")
+       -std=gnu99 -Wnested-externs -Wmissing-prototypes -Wstrict-prototypes")
   if (CMAKE_BUILD_TYPE STREQUAL "Release")
     set (CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -s") # strip
   endif ()
diff --git a/cmake/Modules/FindLibAVCodec.cmake b/cmake/Modules/FindLibAVCodec.cmake
index f1bbf89..118da8b 100644
--- a/cmake/Modules/FindLibAVCodec.cmake
+++ b/cmake/Modules/FindLibAVCodec.cmake
@@ -17,7 +17,18 @@ find_path (AVCODEC_INCLUDE_DIRS libavcodec/avcodec.h)
 find_library (AVCODEC_LIBRARIES NAMES avcodec)
 
 include (FindPackageHandleStandardArgs)
-find_package_handle_standard_args (
-  AVCODEC DEFAULT_MSG AVCODEC_LIBRARIES AVCODEC_INCLUDE_DIRS)
+# This file is FindLibAVCodec.cmake, so find_package() calls the package
+# LibAVCodec. The top-level CMakeLists.txt tests AVCODEC_FOUND, which is
+# what the AVCODEC package name below sets. NAME_MISMATCHED records that
+# the two names differ on purpose. See FindLibAVUtil.cmake.
+if (CMAKE_VERSION VERSION_GREATER_EQUAL "3.17")
+  find_package_handle_standard_args (
+    AVCODEC
+    NAME_MISMATCHED
+    REQUIRED_VARS AVCODEC_LIBRARIES AVCODEC_INCLUDE_DIRS)
+else ()
+  find_package_handle_standard_args (
+    AVCODEC DEFAULT_MSG AVCODEC_LIBRARIES AVCODEC_INCLUDE_DIRS)
+endif ()
 
 mark_as_advanced (AVCODEC_LIBRARIES AVCODEC_INCLUDE_DIRS)
diff --git a/cmake/Modules/FindLibAVUtil.cmake b/cmake/Modules/FindLibAVUtil.cmake
index 464e6cf..94e47dc 100644
--- a/cmake/Modules/FindLibAVUtil.cmake
+++ b/cmake/Modules/FindLibAVUtil.cmake
@@ -17,7 +17,19 @@ find_path (AVUTIL_INCLUDE_DIRS libavutil/cpu.h)
 find_library (AVUTIL_LIBRARIES NAMES avutil)
 
 include (FindPackageHandleStandardArgs)
-find_package_handle_standard_args (
-  AVUTIL DEFAULT_MSG AVUTIL_LIBRARIES AVUTIL_INCLUDE_DIRS)
+# This file is FindLibAVUtil.cmake, so find_package() calls the package
+# LibAVUtil. soxr-config.h.in and the top-level CMakeLists.txt test
+# AVUTIL_FOUND, which is what the AVUTIL package name below sets.
+# NAME_MISMATCHED (CMake 3.17) records that the two names differ on purpose.
+# FOUND_VAR cannot rename the result: CMake only accepts <PackageName>_FOUND.
+if (CMAKE_VERSION VERSION_GREATER_EQUAL "3.17")
+  find_package_handle_standard_args (
+    AVUTIL
+    NAME_MISMATCHED
+    REQUIRED_VARS AVUTIL_LIBRARIES AVUTIL_INCLUDE_DIRS)
+else ()
+  find_package_handle_standard_args (
+    AVUTIL DEFAULT_MSG AVUTIL_LIBRARIES AVUTIL_INCLUDE_DIRS)
+endif ()
 
 mark_as_advanced (AVUTIL_LIBRARIES AVUTIL_INCLUDE_DIRS)
