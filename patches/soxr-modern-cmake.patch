diff --git a/src/data-io.c b/src/data-io.c
index fb61675..621ffa5 100644
--- a/src/data-io.c
+++ b/src/data-io.c
@@ -63,7 +63,12 @@ void _soxr_deinterleave_f(float * * dest, /* Round/clipping not needed here */
 
 
 #if defined FE_INVALID && defined FPU_RINT32 && defined __STDC_VERSION__
-  #if __STDC_VERSION__ >= 199901L
+  /* GCC and Clang both ignore STDC FENV_ACCESS and warn about the pragma.
+     On x86 the quantiser is the fistp instruction, which reads the x87
+     control word itself, so the pragma is not what makes that rounding
+     correct. Emit it only for a C99 compiler that actually implements it.
+     Clang defines __GNUC__, so this excludes both. */
+  #if __STDC_VERSION__ >= 199901L && !defined __GNUC__
     #pragma STDC FENV_ACCESS ON
   #endif
 #endif
@@ -151,7 +156,7 @@ void _soxr_deinterleave_f(float * * dest, /* Round/clipping not needed here */
 #endif
 
 #if defined FE_INVALID && defined FPU_RINT32 && defined __STDC_VERSION__
-  #if __STDC_VERSION__ >= 199901L
+  #if __STDC_VERSION__ >= 199901L && !defined __GNUC__
     #pragma STDC FENV_ACCESS OFF
   #endif
 #endif
