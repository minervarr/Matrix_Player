diff --git a/src/data-io.c b/src/data-io.c
index fb61675..fac6217 100644
--- a/src/data-io.c
+++ b/src/data-io.c
@@ -63,7 +63,10 @@ void _soxr_deinterleave_f(float * * dest, /* Round/clipping not needed here */
 
 
 #if defined FE_INVALID && defined FPU_RINT32 && defined __STDC_VERSION__
-  #if __STDC_VERSION__ >= 199901L
+  /* Clang ignores FENV_ACCESS and warns. GCC honours it, so rint sees
+     the rounding mode. Omitting it on Clang keeps the code Clang already
+     generates. */
