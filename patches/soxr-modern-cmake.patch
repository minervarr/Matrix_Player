     #pragma STDC FENV_ACCESS ON
   #endif
 #endif
@@ -151,7 +154,7 @@ void _soxr_deinterleave_f(float * * dest, /* Round/clipping not needed here */
 #endif
 
 #if defined FE_INVALID && defined FPU_RINT32 && defined __STDC_VERSION__
