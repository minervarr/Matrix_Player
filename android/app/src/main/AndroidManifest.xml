<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sideload-only app (never Play Store) — real filesystem access via the
         "All files access" special permission instead of scoped storage /
         SAF-only tree grants. See docs/superpowers/specs/2026-08-08-android-native-port-design.md. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- AOAS client. The service demands the signature-level permission
         io.nava.aoas.BIND_AOAS, which Android grants at install time only when
         BOTH APKs are signed with the same key (two debug builds on one machine
         share the debug keystore; a release build signed with bruno.jks will
         not bind a debug-signed AOAS). The <queries> declaration is Android 11+
         package visibility: without it, bindService fails as if the service did
         not exist. -->
    <uses-permission android:name="io.nava.aoas.BIND_AOAS" />
    <queries>
        <package android:name="io.nava.aoas" />
    </queries>

    <application android:label="Matrix Player">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="Matrix Player">
            <meta-data
                android:name="android.app.lib_name"
                android:value="matrix_player_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
